<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  const statusInfo = repair ? getStatusInfo(repair.estado) : null;
  const currentStep = statusInfo ? statusInfo.step : 0;
  const progress = currentStep > 0 ? Math.round((currentStep / 5) * 100) : 0;
%>

<main id="contenido">
  <section class="border-b border-outline-variant bg-surface-container-low py-10 md:py-14 print:hidden" data-ticket-search>
    <div class="mx-auto w-full max-w-container-max px-margin-mobile md:px-margin-desktop">
      <nav class="flex items-center gap-1.5 text-xs text-on-surface-variant" aria-label="Ruta de navegación">
        <a href="/" class="rounded transition-colors hover:text-primary">Inicio</a>
        <span class="material-symbols-outlined text-[14px]" aria-hidden="true">chevron_right</span>
        <span class="font-medium text-on-surface" aria-current="page">Estado del ticket</span>
      </nav>
      <div class="mt-4 max-w-2xl">
        <h1 class="text-[32px] font-bold leading-tight tracking-tight text-on-surface md:text-headline-lg">Estado de tu reparación</h1>
        <p class="mt-2 text-body-md text-on-surface-variant">Ingresa el número de ticket que te entregamos al registrar la solicitud y consulta en qué va tu equipo.</p>
      </div>

      <div class="mt-6 rounded-2xl border border-outline-variant bg-surface-container-lowest p-4 shadow-clinic md:p-5">
        <form action="/seguimiento" method="get" class="flex flex-col gap-2 sm:flex-row" data-tracking-form>
          <div class="flex-1">
            <label for="codigo" class="sr-only">Número de ticket</label>
            <div class="relative">
              <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 material-symbols-outlined text-[20px] text-on-surface-variant" aria-hidden="true">confirmation_number</span>
              <input
                id="codigo"
                name="codigo"
                type="text"
                value="<%= codigo %>"
                class="input-clinic pl-11 font-mono uppercase tracking-wide"
                placeholder="Ej: CH-98234"
                autocomplete="off"
                spellcheck="false"
                maxlength="20"
                pattern="[A-Za-z0-9-]{3,20}"
                title="Ingresa el número de ticket, por ejemplo CH-98234"
                required
              >
            </div>
          </div>
          <button type="submit" class="btn-primary shrink-0 px-6 py-3">
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true">search</span>
            Consultar estado
          </button>
        </form>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-on-surface-variant">Prueba con:</span>
          <% demoCodes.forEach((code) => { %>
            <a href="/seguimiento?codigo=<%= code %>" class="rounded-full border border-outline-variant bg-surface-container-low px-2.5 py-1 font-mono text-[11px] font-medium text-on-surface-variant transition-colors hover:border-primary hover:text-primary"><%= code %></a>
          <% }); %>
        </div>
      </div>
    </div>
  </section>

  <section class="py-10 md:py-14">
    <div class="mx-auto w-full max-w-container-max px-margin-mobile md:px-margin-desktop">

      <% if (nuevo && repair) { %>
        <div class="mb-6 flex flex-col gap-3 rounded-2xl border border-primary/30 bg-primary/5 p-5 sm:flex-row sm:items-center sm:justify-between" role="status">
          <div class="flex items-start gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary" aria-hidden="true">
              <span class="material-symbols-outlined text-[22px]">check</span>
            </span>
            <div>
              <p class="font-semibold text-on-surface">¡Solicitud registrada!</p>
              <p class="mt-0.5 text-body-sm text-on-surface-variant">Guarda tu número de ticket: <strong class="font-mono text-primary"><%= repair.codigo %></strong>. Te contactaremos para confirmar la cita.</p>
            </div>
          </div>
          <button type="button" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border border-outline-variant bg-surface-container-lowest px-4 py-2 text-sm font-semibold text-primary transition-colors hover:border-primary" data-copy-code="<%= repair.codigo %>">
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">content_copy</span>
            Copiar ticket
          </button>
        </div>
      <% } %>

      <% if (notFound) { %>
        <div class="rounded-2xl border border-error/25 bg-surface-container-lowest p-6 shadow-clinic md:p-10">
          <div class="mx-auto max-w-lg text-center">
            <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-error-container text-on-error-container" aria-hidden="true">
              <span class="material-symbols-outlined text-[32px]">search_off</span>
            </span>
            <h2 class="mt-4 text-headline-sm text-on-surface">No encontramos el ticket <span class="font-mono"><%= codigo %></span></h2>
            <p class="mt-2 text-body-sm text-on-surface-variant">Revisa que el código esté bien escrito. Debe tener el formato CH-12345. Si el problema continúa, contáctanos con tu número de cédula y el nombre del titular.</p>
            <div class="mt-5 flex flex-col justify-center gap-2 sm:flex-row">
              <a href="/seguimiento" class="btn-primary px-5 py-3 text-sm">
                <span class="material-symbols-outlined text-[20px]" aria-hidden="true">restart_alt</span>
                Intentar de nuevo
              </a>
              <a href="/agendar" class="btn-secondary px-5 py-3 text-sm">Registrar nueva solicitud</a>
            </div>
            <% if (demoCodes.length) { %>
              <div class="mt-6 border-t border-outline-variant/60 pt-5">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-on-surface-variant">Tickets de demostración disponibles</p>
                <div class="mt-2 flex flex-wrap justify-center gap-2">
                  <% demoCodes.forEach((code) => { %>
                    <a href="/seguimiento?codigo=<%= code %>" class="rounded-full border border-outline-variant bg-surface-container-low px-3 py-1.5 font-mono text-xs text-on-surface-variant transition-colors hover:border-primary hover:text-primary"><%= code %></a>
                  <% }); %>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      <% } else if (repair) { %>

        <div class="grid gap-6 lg:grid-cols-[1.55fr_0.85fr] lg:items-start">
          <div class="space-y-6">
            <div class="print-only mb-2 border-b border-black pb-3">
              <p class="text-lg font-bold">Cellphone Hospital</p>
              <p class="text-xs"><%= business.address %> · <%= business.city %></p>
              <p class="text-xs"><%= business.phone %> · <%= business.email %></p>
              <p class="mt-2 text-[10px]">Comprobante de demostración académica. Los datos del ticket son ficticios.</p>
            </div>
            <!-- Estado actual -->
            <section class="overflow-hidden rounded-2xl border border-outline-variant bg-surface-container-lowest shadow-clinic" aria-labelledby="estado-actual">
              <div class="flex flex-col gap-4 p-5 md:flex-row md:items-center md:justify-between md:p-6">
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-wider text-on-surface-variant">Ticket</p>
                  <div class="mt-0.5 flex items-center gap-2">
                    <h2 id="estado-actual" class="font-mono text-2xl font-bold text-on-surface"><%= repair.codigo %></h2>
                    <button type="button" class="rounded-lg p-1.5 text-on-surface-variant transition-colors hover:bg-surface-container hover:text-primary" data-copy-code="<%= repair.codigo %>" aria-label="Copiar número de ticket">
                      <span class="material-symbols-outlined text-[18px]" aria-hidden="true">content_copy</span>
                    </button>
                  </div>
                  <p class="mt-1 text-body-sm text-on-surface-variant">Registrado el <%= formatDateTime(repair.creado_en) %></p>
                </div>
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-bold uppercase tracking-wide <%= statusInfo.className %>">
                  <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
                  <%= statusInfo.label %>
                </span>
              </div>

              <% if (repair.estado === 'CANCELADO') { %>
                <div class="mx-5 mb-5 flex items-start gap-2 rounded-xl border border-error/30 bg-error-container p-4 text-body-sm text-on-error-container md:mx-6 md:mb-6" role="alert">
                  <span class="material-symbols-outlined text-[20px]" aria-hidden="true">warning</span>
                  <p>Esta reparación fue cancelada. Si tienes dudas, comunícate con la tienda indicando tu número de ticket.</p>
                </div>
              <% } else { %>
                <div class="border-t border-outline-variant/60 bg-surface-container-low px-5 py-6 md:px-8">
                  <div class="relative">
                    <div class="absolute left-[12.5%] right-[12.5%] top-4 h-0.5 bg-outline-variant" aria-hidden="true"></div>
                    <div class="absolute left-[12.5%] top-4 h-0.5 bg-primary transition-all duration-500" style="width: calc((100% - 25%) * <%= Math.max(0, currentStep - 1) / 3 %>)" aria-hidden="true"></div>
                    <ol class="relative grid grid-cols-4 gap-1">
                      <% REPAIR_TIMELINE.forEach((step) => { %>
                        <%
                          const done = currentStep >= step.step;
                          const current = currentStep === step.step;
                        %>
                        <li class="flex flex-col items-center text-center">
                          <span class="flex h-8 w-8 items-center justify-center rounded-full border-2 text-[11px] font-bold <%= done ? 'border-primary bg-primary text-on-primary' : 'border-outline-variant bg-surface-container-lowest text-on-surface-variant' %> <%= current ? 'ring-4 ring-primary/15' : '' %>">
                            <% if (done) { %>
                              <span class="material-symbols-outlined text-[16px]" aria-hidden="true">check</span>
                            <% } else { %>
                              <%= step.step %>
                            <% } %>
                          </span>
                          <span class="mt-2 text-[10px] font-semibold leading-tight sm:text-[11px] <%= current ? 'text-primary' : done ? 'text-on-surface' : 'text-on-surface-variant' %>"><%= step.short %></span>
                          <% if (current) { %><span class="mt-0.5 hidden text-[9px] uppercase tracking-wider text-primary sm:block">Aquí está</span><% } %>
                        </li>
                      <% }); %>
                    </ol>
                  </div>
                  <div class="mt-5 flex items-center gap-3 rounded-xl border border-outline-variant bg-surface-container-lowest p-3">
                    <div class="h-2 flex-1 overflow-hidden rounded-full bg-surface-container-high" role="progressbar" aria-valuenow="<%= progress %>" aria-valuemin="0" aria-valuemax="100" aria-label="Progreso de la reparación">
                      <div class="h-full rounded-full bg-primary transition-all duration-500" style="width: <%= progress %>%"></div>
                    </div>
                    <span class="text-xs font-bold text-primary"><%= progress %>%</span>
                  </div>
                </div>
              <% } %>
            </section>

            <!-- Detalles -->
            <section class="rounded-2xl border border-outline-variant bg-surface-container-lowest p-5 shadow-clinic md:p-6" aria-labelledby="detalles-ticket">
              <h2 id="detalles-ticket" class="text-headline-sm text-on-surface">Detalles del servicio</h2>
              <dl class="mt-4 grid gap-x-6 gap-y-4 sm:grid-cols-2">
                <div>
                  <dt class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant">Cliente</dt>
                  <dd class="mt-0.5 text-body-sm font-medium text-on-surface"><%= repair.nombre %></dd>
                </div>
                <div>
                  <dt class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant">Dispositivo</dt>
                  <dd class="mt-0.5 text-body-sm font-medium text-on-surface"><%= repair.dispositivo %></dd>
                </div>
                <div>
                  <dt class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant">Servicio</dt>
                  <dd class="mt-0.5 text-body-sm font-medium text-on-surface"><%= repair.servicio %></dd>
                </div>
                <div>
                  <dt class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant">Tipo de problema</dt>
                  <dd class="mt-0.5 text-body-sm font-medium text-on-surface"><%= repair.problema %></dd>
                </div>
                <div>
                  <dt class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant">Cita preferida</dt>
                  <dd class="mt-0.5 text-body-sm font-medium text-on-surface">
                    <%= repair.fecha_preferida ? formatDate(repair.fecha_preferida) : 'Sin fecha definida' %>
                    <%= repair.franja ? ` · ${repair.franja}` : '' %>
                  </dd>
                </div>
                <div>
                  <dt class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant">Última actualización</dt>
                  <dd class="mt-0.5 text-body-sm font-medium text-on-surface"><%= formatDateTime(repair.actualizado_en) %></dd>
                </div>
                <% if (repair.descripcion) { %>
                  <div class="sm:col-span-2">
                    <dt class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant">Descripción del caso</dt>
                    <dd class="mt-1 rounded-xl bg-surface-container-low p-3 text-body-sm text-on-surface-variant"><%= repair.descripcion %></dd>
                  </div>
                <% } %>
              </dl>
            </section>

            <!-- Historial -->
            <section class="rounded-2xl border border-outline-variant bg-surface-container-lowest p-5 shadow-clinic md:p-6" aria-labelledby="historial-ticket">
              <h2 id="historial-ticket" class="text-headline-sm text-on-surface">Historial</h2>
              <p class="mt-1 text-body-sm text-on-surface-variant">Cada cambio de estado queda registrado con fecha y nota del taller.</p>
              <ol class="mt-5 space-y-0">
                <% history.forEach((item, index) => { %>
                  <%
                    const itemStatus = getStatusInfo(item.estado);
                    const isLast = index === history.length - 1;
                  %>
                  <li class="relative flex gap-4 pb-6 <%= isLast ? 'pb-0' : '' %>">
                    <% if (!isLast) { %>
                      <span class="absolute left-[13px] top-7 h-[calc(100%-1.25rem)] w-0.5 bg-outline-variant" aria-hidden="true"></span>
                    <% } %>
                    <span class="relative z-10 mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full <%= isLast ? 'bg-primary text-on-primary' : 'border border-outline-variant bg-surface-container-lowest text-on-surface-variant' %>">
                      <span class="material-symbols-outlined filled text-[14px]" aria-hidden="true"><%= isLast ? 'check' : 'history' %></span>
                    </span>
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <p class="text-sm font-semibold text-on-surface"><%= itemStatus.label %></p>
                        <span class="text-[11px] text-on-surface-variant"><%= formatDateTime(item.creado_en) %></span>
                      </div>
                      <% if (item.nota) { %>
                        <p class="mt-1 text-body-sm text-on-surface-variant"><%= item.nota %></p>
                      <% } %>
                    </div>
                  </li>
                <% }); %>
              </ol>
            </section>
          </div>

          <aside class="space-y-5 lg:sticky lg:top-24 print:hidden" data-ticket-aside>
            <div class="rounded-2xl border border-outline-variant bg-surface-container-lowest p-5 shadow-clinic">
              <h2 class="text-headline-sm text-on-surface">Acciones</h2>
              <div class="mt-4 space-y-2">
                <button type="button" class="btn-secondary w-full px-4 py-3 text-sm" data-copy-code="<%= repair.codigo %>">
                  <span class="material-symbols-outlined text-[20px]" aria-hidden="true">content_copy</span>
                  Copiar número de ticket
                </button>
                <button type="button" class="btn-secondary w-full px-4 py-3 text-sm" data-print-ticket>
                  <span class="material-symbols-outlined text-[20px]" aria-hidden="true">print</span>
                  Imprimir comprobante
                </button>
                <a href="/seguimiento" class="btn-secondary w-full px-4 py-3 text-sm">
                  <span class="material-symbols-outlined text-[20px]" aria-hidden="true">search</span>
                  Consultar otro ticket
                </a>
              </div>
            </div>

            <div class="rounded-2xl border border-primary/25 bg-primary/5 p-5">
              <h2 class="text-base font-semibold text-on-surface">¿Dudas sobre tu reparación?</h2>
              <p class="mt-2 text-body-sm text-on-surface-variant">Visítanos en la tienda con tu número de ticket. La información de contacto se muestra como texto mientras el sitio está en revisión.</p>
              <div class="mt-3 space-y-2 text-body-sm text-on-surface">
                <p class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-primary" aria-hidden="true">call</span><%= business.phone %></p>
                <p class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-primary" aria-hidden="true">mail</span><%= business.email %></p>
                <p class="flex items-start gap-2"><span class="material-symbols-outlined text-[18px] text-primary" aria-hidden="true">schedule</span><%= business.hours %></p>
              </div>
            </div>

            <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-5">
              <p class="flex items-start gap-2 text-[11px] leading-relaxed text-on-surface-variant">
                <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">info</span>
                Este seguimiento es una demostración académica. Los estados y notas del historial son datos ficticios.
              </p>
            </div>
          </aside>
        </div>

      <% } else { %>
        <div class="rounded-2xl border border-outline-variant bg-surface-container-lowest p-6 text-center shadow-clinic md:p-12">
          <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-primary" aria-hidden="true">
            <span class="material-symbols-outlined text-[32px]">receipt_long</span>
          </span>
          <h2 class="mt-4 text-headline-sm text-on-surface">Consulta el estado de tu equipo</h2>
          <p class="mx-auto mt-2 max-w-lg text-body-sm text-on-surface-variant">Escribe tu número de ticket en el buscador de arriba. Si acabas de agendar, lo encontrarás en el mensaje de confirmación.</p>
          <div class="mx-auto mt-6 max-w-xl rounded-xl border border-outline-variant bg-surface-container-low p-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-on-surface-variant">Tickets de demostración</p>
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              <% demoCodes.forEach((code) => { %>
                <a href="/seguimiento?codigo=<%= code %>" class="flex items-center justify-between gap-2 rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2.5 font-mono text-sm text-on-surface transition-colors hover:border-primary hover:text-primary">
                  <%= code %>
                  <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
                </a>
              <% }); %>
            </div>
          </div>
          <p class="mt-4 text-xs text-on-surface-variant">¿No tienes ticket? <a href="/agendar" class="rounded font-semibold text-primary underline decoration-primary/30 underline-offset-2 hover:decoration-primary">Agenda una reparación</a>.</p>
        </div>
      <% } %>
    </div>
  </section>

  <% if (nuevo && repair) { %>
    <dialog id="ticket-created-dialog" class="modal-dialog max-w-md" aria-labelledby="ticket-created-title">
      <div class="p-6 text-center">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-primary" aria-hidden="true">
          <span class="material-symbols-outlined text-[30px]">check_circle</span>
        </span>
        <h2 id="ticket-created-title" class="mt-4 text-headline-sm text-on-surface">¡Ticket creado!</h2>
        <p class="mt-2 text-body-sm text-on-surface-variant">Guarda este número. Lo necesitarás para consultar el estado de tu reparación.</p>
        <p class="mt-4 rounded-xl border border-primary/25 bg-primary/5 px-4 py-3 font-mono text-2xl font-bold tracking-wide text-primary"><%= repair.codigo %></p>
        <div class="mt-5 flex flex-col gap-2">
          <button type="button" class="btn-primary w-full px-5 py-3 text-sm" data-copy-code="<%= repair.codigo %>">
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true">content_copy</span>
            Copiar número de ticket
          </button>
          <button type="button" class="btn-secondary w-full px-5 py-3 text-sm" data-close-ticket-dialog>
            Ver mi reparación
          </button>
        </div>
        <p class="mt-4 text-[11px] leading-relaxed text-on-surface-variant">Te contactaremos para confirmar la cita. Si cierras esta ventana, el número seguirá visible en la página.</p>
      </div>
    </dialog>
  <% } %>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts', { pageScript: 'seguimiento' }) %>
